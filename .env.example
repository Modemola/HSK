# Copy to .env and `set -a; source .env; set +a` before running deploy / demo.
# Never commit real keys. Use fresh wallets that hold only demo funds.

# ---- Network -------------------------------------------------------------
# local | testnet | mainnet   (local needs nothing else)
CORRIDOR_NETWORK=mainnet
# HSK_MAINNET_RPC=https://mainnet.hsk.xyz
# HSK_TESTNET_RPC=https://testnet.hsk.xyz

# ---- Keys (mainnet / testnet only) ---------------------------------------
# Deployer + relayer (owns the contracts, anchors receipts and evidence). Needs HSK for gas.
DEPLOYER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
# Sending operator (registered Sender). Needs HSK for gas and a few USDC.e.
SENDER_PRIVATE_KEY=
# Payout operators (registered Payout). Need HSK for gas.
PAYOUT_A_PRIVATE_KEY=
PAYOUT_B_PRIVATE_KEY=

# ---- Demo tuning -----------------------------------------------------------
# Fraction of the real USD value locked on chain (0.001 → ~4 USDC.e for the whole demo).
CORRIDOR_VALUE_SCALE=0.001
# Escrow SLA in seconds (contract minimum 60). Short so the refund case finishes quickly.
CORRIDOR_SLA_SECONDS=90

# ---- HSP Coordinator (from the organisers; leave empty to use the local simulator)
HSP_COORDINATOR_URL=
HSP_API_KEY=
HSP_ISSUER_URL=
HSP_PRIVATE_KEY=
HSP_CHAIN=hashkey-testnet
HSP_ADAPTER_ADDRESS=
HSP_TRUSTED_ISSUERS=

# ---- Claude (memo intent + analyst narrative; heuristic fallback if unset) ----
ANTHROPIC_API_KEY=
# CORRIDOR_MODEL=claude-opus-5-5
